---
import '../styles/global.css';
import Logo from '../components/Logo.astro';

interface BreadcrumbSegment {
	label: string;
	href?: string;
}

interface Props {
	title: string;
	command: string;
	description?: string;
	mode?: string;
	status?: string;
	editHref?: string;
	backHref?: string;
	noindex?: boolean;
	breadcrumb?: BreadcrumbSegment[];
	// Share-card overrides; default to the site-wide card.
	ogImage?: string;
	ogType?: 'website' | 'article';
	// Schema.org objects emitted as JSON-LD (a BreadcrumbList is added automatically).
	jsonLd?: Record<string, unknown>[];
}

const {
	title,
	command,
	description,
	mode = 'NORMAL',
	status,
	editHref,
	backHref,
	noindex = false,
	breadcrumb = [],
	ogImage = '/og-image.png',
	ogType = 'website',
	jsonLd = [],
} = Astro.props;

// Share-card metadata. Astro.site comes from astro.config `site`.
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);

// Mirrors the statusline path. Segment labels carry a trailing "/" for
// directories; the last segment is the current page and needs no URL.
const breadcrumbLd = breadcrumb.length > 0 && {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [{ label: 'cli.masoko.net', href: '/' }, ...breadcrumb].map((segment, i, all) => ({
		'@type': 'ListItem',
		position: i + 1,
		name: segment.label.replace(/\/$/, ''),
		...(i < all.length - 1 && segment.href ? { item: new URL(segment.href, Astro.site).href } : {}),
	})),
};
// Escape `<` so content can never close the <script> element early.
const ldJson = [...jsonLd, breadcrumbLd]
	.filter(Boolean)
	.map((entry) => JSON.stringify(entry).replace(/</g, '\\u003c'));
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#0f1013" media="(prefers-color-scheme: dark)" />
		<meta name="theme-color" content="#e4e9df" media="(prefers-color-scheme: light)" />
		{noindex && <meta name="robots" content="noindex, follow" />}
		{description && <meta name="description" content={description} />}
		<title>{title}</title>
		{!noindex && <link rel="canonical" href={pageUrl} />}
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="The Terminal Index" />
		<meta property="og:title" content={title} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:image" content={ogImageUrl} />
		{description && <meta property="og:description" content={description} />}
		{description && <meta name="twitter:description" content={description} />}
		{ldJson.map((json) => <script is:inline type="application/ld+json" set:html={json} />)}
		<script defer src="https://m.masoko.net/core-util" data-website-id="b005feb8-941a-4967-b499-0a0b5f2eff9e"></script>
	</head>
	<body>
		<div class="term">
			<div class="term-bar">
				<a class="term-logo" href="/" aria-label="The Terminal Index home"><Logo /></a>
				<p class="term-title"><span class="user">visitor@cli.masoko.net</span>:~$ {command}</p>
				{backHref && <a class="back" href={backHref}>&larr; cd ..</a>}
			</div>
			<div class="term-body">
				<slot />
			</div>
			<footer class="statusline">
				<span class="mode">{mode}</span>
				<span class="seg path">
					~/{breadcrumb.length > 0 ? <a href="/">cli.masoko.net</a> : 'cli.masoko.net'}
					{breadcrumb.map((segment, i) => (
						<>
							<span class="sep">/</span>
							{i < breadcrumb.length - 1 && segment.href ? (
								<a href={segment.href}>{segment.label}</a>
							) : (
								segment.label
							)}
						</>
					))}
				</span>
				{status && <span class="seg" data-status>{status}</span>}
				<span class="seg right">
					{editHref && (
						<>
							<a href={editHref}>edit</a>
							<span class="sep">·</span>
						</>
					)}
					<a href="/submit/">submit</a>
					<span class="sep">·</span>
					<a class="icon-link" href="https://github.com/hjelev/cli" target="_blank" rel="noopener" aria-label="GitHub repository">
						<svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
							<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
						</svg>
					</a>
				</span>
			</footer>
		</div>
	</body>
</html>
