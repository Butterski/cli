---
import { getCollection } from 'astro:content';
import { slugify } from '../../lib/slug';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LanguageIcon from '../../components/LanguageIcon.astro';

const tools = await getCollection('tools');
const descriptions = new Map((await getCollection('languages')).map((entry) => [entry.id, entry.data.description]));
// Group by slug so languages that collide (see languages/[language]/[...page].astro)
// get one entry whose count matches the page it links to.
const bySlug = new Map<string, { label: string; toolIds: Set<string> }>();
for (const tool of tools) {
	const slug = slugify(tool.data.language);
	const entry = bySlug.get(slug) ?? { label: tool.data.language, toolIds: new Set<string>() };
	if (!entry.label.split(' / ').includes(tool.data.language)) entry.label += ` / ${tool.data.language}`;
	entry.toolIds.add(tool.id);
	bySlug.set(slug, entry);
}
const languages = [...bySlug.entries()]
	.map(([slug, { label, toolIds }]) => ({ slug, label, count: toolIds.size }))
	// Biggest languages first, matching /categories; slug as a stable tiebreak.
	.sort((a, b) => b.count - a.count || a.slug.localeCompare(b.slug));
---

<BaseLayout
	title="Languages — The Terminal Index"
	command="ls languages/"
	backHref="/"
	breadcrumb={[{ label: 'languages/' }]}
>
	<header class="hero">
		<h1>Languages</h1>
		<p class="tagline"># browse tools by language</p>
		<nav class="browse-links">
			<a href="/categories">ls categories/</a>
			<a href="/tags">ls tags/</a>
		</nav>
	</header>

	<ul class="dir-grid">
		{
			languages.map(({ slug, label, count }) => (
				<li>
					<a href={`/languages/${slug}`}>
						<span class="dir-head">
							<span class="dir-name"><LanguageIcon language={label} />{label}/</span>
							<span class="count">{count}</span>
						</span>
						{descriptions.get(slug) && <span class="dir-desc">{descriptions.get(slug)}</span>}
					</a>
				</li>
			))
		}
	</ul>
</BaseLayout>
