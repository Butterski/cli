---
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../../lib/schema';
import { slugify } from '../../lib/slug';
import BaseLayout from '../../layouts/BaseLayout.astro';

const tools = await getCollection('tools');
const descriptions = new Map((await getCollection('categories')).map((entry) => [entry.id, entry.data.description]));
const counts = new Map<string, number>();
for (const tool of tools) {
	counts.set(tool.data.category, (counts.get(tool.data.category) ?? 0) + 1);
}
// Biggest categories first; name as a stable tiebreak.
const nonEmptyCategories = CATEGORIES.filter((category) => (counts.get(category) ?? 0) > 0).sort(
	(a, b) => counts.get(b)! - counts.get(a)! || a.localeCompare(b),
);
---

<BaseLayout
	title="Categories — The Terminal Index"
	command="ls categories/"
	backHref="/"
	breadcrumb={[{ label: 'categories/' }]}
>
	<header class="hero">
		<h1>Categories</h1>
		<p class="tagline"># browse tools grouped by category</p>
		<nav class="browse-links">
			<a href="/tags">ls tags/</a>
			<a href="/languages">ls languages/</a>
		</nav>
	</header>

	<ul class="dir-grid">
		{
			nonEmptyCategories.map((category) => (
				<li>
					<a href={`/categories/${slugify(category)}`}>
						<span class="dir-head">
							<span class="dir-name">{category}/</span>
							<span class="count">{counts.get(category)}</span>
						</span>
						{descriptions.get(slugify(category)) && (
							<span class="dir-desc">{descriptions.get(slugify(category))}</span>
						)}
					</a>
				</li>
			))
		}
	</ul>
</BaseLayout>
